---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroDecision from '../components/HeroDecision.astro';
import DecisionListItem from '../components/DecisionListItem.astro';
import EmptyState from '../components/EmptyState.astro';
import { DEFAULT_LANG, t } from '../i18n/ui';
import { decisionFeed } from '../lib/decisions';

const lang = DEFAULT_LANG;
const s = t(lang);

// One en entry per decision, newest first: the latest is featured, the rest listed.
const [latest, ...past] = await decisionFeed();
---

<BaseLayout activeTab="decisions" lang={lang} description={s.tagline}>
  <section class="pt-8">
    <p class="text-sm font-medium text-muted">{s.tagline}</p>
  </section>

  <section class="mt-6">
    {latest ? <HeroDecision entry={latest} lang={lang} /> : <EmptyState title={s.noDecisions} />}
  </section>

  {
    past.length > 0 ? (
      <section class="mt-12">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-faint">
          {s.recentDecisions}
        </h2>
        <div class="flex flex-col gap-3">
          {past.map((entry) => (
            <DecisionListItem entry={entry} lang={lang} />
          ))}
        </div>
      </section>
    ) : null
  }
</BaseLayout>
